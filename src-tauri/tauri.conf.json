{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SpreadGL2",
  "version": "0.1.0",
  "identifier": "io.github.spreadgl2.spreadgl2",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "SpreadGL2",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob: https://basemaps.cartocdn.com https://*.basemaps.cartocdn.com; font-src 'self' asset: data:; connect-src 'self' ipc: http://ipc.localhost https://basemaps.cartocdn.com https://*.basemaps.cartocdn.com; worker-src 'self' blob:; child-src 'self' blob:; manifest-src 'self'",
      "headers": {
        "X-Content-Type-Options": "nosniff"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["tree", "trees", "nex", "nexus"],
        "name": "BEAST X Tree",
        "description": "BEAST X phylogenetic tree file",
        "role": "Viewer",
        "mimeType": "application/x-beast-tree"
      }
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
