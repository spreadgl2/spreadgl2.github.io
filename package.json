{
  "name": "spreadgl2",
  "version": "0.1.0",
  "description": "Interactive visualization and analysis of BEAST X phylogeographic trees",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ci": "vitest run --exclude 'tests/b117-perf-budget.test.ts'",
    "test:stress": "vitest run tests/b117-perf-budget.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/pedv-smoke.spec.ts e2e/yfv-smoke.spec.ts e2e/usability-publication.spec.ts",
    "test:e2e:full": "playwright test --grep-invert @perf",
    "test:e2e:perf": "playwright test --grep @perf --workers=1",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && eslint src/lib/phylo --no-error-on-unmatched-pattern && tsx scripts/check-typography.ts",
    "lint:fix": "biome check --write . && eslint src/lib/phylo --fix --no-error-on-unmatched-pattern",
    "check-typography": "tsx scripts/check-typography.ts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.11",
    "@deck.gl/extensions": "^9.3.11",
    "@deck.gl/layers": "^9.3.11",
    "@deck.gl/react": "^9.3.11",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-store": "^2.4.4",
    "comlink": "^4.4.2",
    "geotiff": "^3.0.5",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.41.0",
    "luxon": "^3.7.2",
    "maplibre-gl": "^6.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-map-gl": "^8.1.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/geojson": "^7946.0.16",
    "@types/luxon": "^3.7.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vitest-axe": "^0.1.0"
  }
}
